# Postgres from docker-compose.yml
DATABASE_URL=postgres://proteingo:proteingo@localhost:5432/proteingo

# openssl rand -base64 32
BETTER_AUTH_SECRET=
# Browser origin. Vite proxies /api, so cookies stay on this host.
BETTER_AUTH_URL=http://localhost:5173
WEB_ORIGIN=http://localhost:5173

# Google Cloud OAuth client. Authorized redirect URI:
# http://localhost:5173/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated ucr.edu addresses that can open /admin
ADMIN_EMAILS=

PORT=3001

# Cloudflare R2. Leave blank to store GLBs on local disk (apps/server/uploads).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public bucket base, no trailing slash. Required for the AR viewer to fetch
# models directly from R2. The bucket CORS policy must allow GET from the web origin.
R2_PUBLIC_URL=
