# Postgres from docker-compose.yml
DATABASE_URL=postgres://proteingo:proteingo@localhost:5432/proteingo

# openssl rand -base64 32
BETTER_AUTH_SECRET=
# Browser origin. Vite proxies /api, so cookies stay on this host.
BETTER_AUTH_URL=http://localhost:5173
WEB_ORIGIN=http://localhost:5173

# Google Cloud OAuth client. Authorized redirect URI:
# http://localhost:5173/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated ucr.edu addresses that can open /admin
ADMIN_EMAILS=

PORT=3001

# Cloudflare R2. Leave blank to store GLBs on local disk (apps/server/uploads).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Models are served through the API (behind sign-in), so the bucket can stay private.

# Local only: skip Google sign-in and act as DEV_BYPASS_EMAIL (ignored in production).
# Add the same address to ADMIN_EMAILS to open /admin.
DEV_BYPASS_AUTH=false
DEV_BYPASS_EMAIL=dev@ucr.edu
# The second dev account offered on the login page: a normal student (not in ADMIN_EMAILS).
DEV_STUDENT_EMAIL=student@ucr.edu
