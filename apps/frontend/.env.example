# Mapbox public access token (pk.…). Restrict it to this site's URLs.
VITE_MAPBOX_TOKEN=
# Hosted API origin for static deploys (blank in dev; Vite proxies /api)
VITE_API_URL=
# Variant Launch SDK key: WebXR AR on iPhone through an App Clip (https://launchar.app). Blank = iPhone gets the 3D viewer.
VITE_VARIANT_LAUNCH_KEY=
# Show the AR viewer dev tools toggle. Defaults to on for `npm run dev`, off for builds.
# VITE_ENABLE_DEBUG_TOOLS=false
